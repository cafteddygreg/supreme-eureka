<%- include('partials/header', { title: 'Administration - Igitoro Live' }) %>

<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
  <div>
    <h1 style="margin: 0; font-size: 1.8rem; color: var(--pine-dark);">Tableau de bord Administrateur</h1>
    <p class="muted" style="margin: 4px 0 0;">Supervision, modération et gestion opérationnelle d'Igitoro Live.</p>
  </div>
  <a href="/" class="btn" style="background: var(--surface); border: 1px solid var(--line);">← Retour à l'accueil</a>
</div>

<!-- ================= 1. STATISTIQUES OPÉRATIONNELLES ================= -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 24px;">
  <div class="card" style="padding: 16px; text-align: center;">
    <span style="font-size: 0.8rem; color: var(--muted); font-weight: 600; text-transform: uppercase;">Stations</span>
    <p style="font-size: 1.8rem; font-weight: 800; color: var(--pine); margin: 6px 0 2px;"><%= stats.activeStations %> / <%= stats.totalStations %></p>
    <small style="color: var(--muted);">actives répertoriées</small>
  </div>
  <div class="card" style="padding: 16px; text-align: center;">
    <span style="font-size: 0.8rem; color: var(--muted); font-weight: 600; text-transform: uppercase;">Signalements</span>
    <p style="font-size: 1.8rem; font-weight: 800; color: var(--pine); margin: 6px 0 2px;"><%= stats.totalReports %></p>
    <small style="color: var(--muted);"><%= stats.recentReports24h %> dernières 24h</small>
  </div>
  <div class="card" style="padding: 16px; text-align: center;">
    <span style="font-size: 0.8rem; color: var(--muted); font-weight: 600; text-transform: uppercase;">Confirmations</span>
    <p style="font-size: 1.8rem; font-weight: 800; color: var(--emerald-600); margin: 6px 0 2px;"><%= stats.totalConfirmations %></p>
    <small style="color: var(--muted);"><%= stats.totalContradictions %> contradictions</small>
  </div>
  <div class="card" style="padding: 16px; text-align: center; border-left: 4px solid var(--amber);">
    <span style="font-size: 0.8rem; color: var(--amber-dark); font-weight: 600; text-transform: uppercase;">Revendications</span>
    <p style="font-size: 1.8rem; font-weight: 800; color: var(--amber-dark); margin: 6px 0 2px;"><%= stats.pendingClaims %></p>
    <small style="color: var(--muted);">en attente d'examen</small>
  </div>
  <div class="card" style="padding: 16px; text-align: center; border-left: 4px solid var(--crimson);">
    <span style="font-size: 0.8rem; color: var(--crimson); font-weight: 600; text-transform: uppercase;">Abus signalés</span>
    <p style="font-size: 1.8rem; font-weight: 800; color: var(--crimson); margin: 6px 0 2px;"><%= stats.pendingAbuse %></p>
    <small style="color: var(--muted);">à modérer</small>
  </div>
</div>

<!-- ================= ONGLETS D'ADMINISTRATION ================= -->
<div id="admin-feedback-banner" class="card hidden" style="margin-bottom: 16px; padding: 12px 16px; border-left: 4px solid var(--emerald-600); font-weight: 600;"></div>

<div class="chips admin-tabs" style="margin-bottom: 20px; border-bottom: 1px solid var(--line); padding-bottom: 8px;">
  <button type="button" class="chip selected admin-tab-btn" onclick="showAdminTab('stations', this)">Stations (<%= stations.length %>)</button>
  <button type="button" class="chip admin-tab-btn" onclick="showAdminTab('claims', this)">Revendications (<%= claims.filter(c => c.status === 'pending').length %>)</button>
  <button type="button" class="chip admin-tab-btn" onclick="showAdminTab('abuse', this)">Modération Abus (<%= abuseList.filter(a => a.status === 'pending').length %>)</button>
  <button type="button" class="chip admin-tab-btn" onclick="showAdminTab('users', this)">Utilisateurs (<%= userList.length %>)</button>
  <button type="button" class="chip admin-tab-btn" onclick="showAdminTab('logs', this)">Journal d'actions</button>
</div>

<!-- ================= SECTION 1 : GESTION DES STATIONS ================= -->
<div id="tab-stations" class="admin-section">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
    <h2 style="margin: 0; font-size: 1.25rem;">Stations-service</h2>
    <button type="button" class="btn btn-primary" id="open-add-station-btn" onclick="toggleAddStationModal(true)">+ Ajouter une station</button>
  </div>

  <div style="margin-bottom: 12px;">
    <input type="search" placeholder="Rechercher une station à gérer..." oninput="filterAdminStations(this.value)">
  </div>

  <div style="overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md);">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
      <thead>
        <tr style="background: var(--surface-subtle); border-bottom: 1px solid var(--line); color: var(--muted);">
          <th style="padding: 12px 14px;">Nom & Marque</th>
          <th style="padding: 12px 14px;">Commune & Zone</th>
          <th style="padding: 12px 14px;">Carburants</th>
          <th style="padding: 12px 14px;">Vérification</th>
          <th style="padding: 12px 14px;">Statut</th>
          <th style="padding: 12px 14px; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody id="admin-stations-tbody">
        <% for (const s of stations) { %>
          <tr class="admin-station-row" data-name="<%= s.name.toLowerCase() %>" data-zone="<%= s.zone.toLowerCase() %>" data-commune="<%= (s.commune || '').toLowerCase() %>" style="border-bottom: 1px solid var(--line);">
            <td style="padding: 12px 14px;">
              <strong style="color: var(--pine-dark);"><%= s.name %></strong>
              <% if (s.brand) { %><span class="chip" style="font-size: 0.72rem; padding: 2px 6px; margin-left: 6px;"><%= s.brand %></span><% } %>
              <div class="muted" style="font-size: 0.8rem; margin-top: 2px;"><%= s.location_text %></div>
            </td>
            <td style="padding: 12px 14px;">
              <div><%= s.commune || 'Bujumbura' %></div>
              <small class="muted"><%= s.zone %></small>
            </td>
            <td style="padding: 12px 14px;"><%= s.fuels || 'Essence, Diesel' %></td>
            <td style="padding: 12px 14px;">
              <% if (s.is_verified) { %>
                <span class="chip" style="background: var(--emerald-100); color: var(--emerald-600); font-size: 0.75rem;">✓ Vérifiée</span>
              <% } else { %>
                <span class="muted" style="font-size: 0.8rem;">Standard</span>
              <% } %>
            </td>
            <td style="padding: 12px 14px;">
              <span class="chip" style="background: <%= s.is_active ? 'var(--emerald-100)' : 'var(--crimson-soft)' %>; color: <%= s.is_active ? 'var(--emerald-600)' : 'var(--crimson)' %>; font-size: 0.75rem;">
                <%= s.is_active ? 'Active' : 'Désactivée' %>
              </span>
            </td>
            <td style="padding: 12px 14px; text-align: right; white-space: nowrap;">
              <button type="button" class="btn" style="padding: 6px 10px; font-size: 0.78rem; background: var(--surface-subtle); border: 1px solid var(--line);" onclick="toggleStationActive(<%= s.id %>)">
                <%= s.is_active ? 'Désactiver' : 'Activer' %>
              </button>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- ================= SECTION 2 : DEMANDES DE REVENDICATION ================= -->
<div id="tab-claims" class="admin-section hidden">
  <h2 style="font-size: 1.25rem; margin-bottom: 12px;">Demandes de Revendication de Stations</h2>
  <p class="muted" style="font-size: 0.88rem; margin-bottom: 16px;">
    Examinez les gérants et représentants qui demandent à être officiellement rattachés à une station existante.
  </p>

  <% const pendingClaims = claims.filter(c => c.status === 'pending'); %>
  <% if (pendingClaims.length === 0) { %>
    <div class="card" style="text-align: center; padding: 24px; color: var(--muted);">
      Aucune demande de revendication en attente.
    </div>
  <% } else { %>
    <div style="display: grid; gap: 12px;">
      <% for (const c of pendingClaims) { %>
        <% const st = stations.find(s => s.id === c.station_id); %>
        <div class="card" style="border-left: 4px solid var(--amber);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap;">
            <div>
              <strong style="font-size: 1.05rem; color: var(--pine-dark);"><%= st ? st.name : 'Station inconnue' %></strong>
              <span class="muted" style="font-size: 0.82rem; margin-left: 6px;"><%= st ? st.zone : '' %></span>
              <p style="margin: 6px 0 2px; font-size: 0.88rem;"><strong>Représentant :</strong> <%= c.contact_name %> (<%= c.role %>)</p>
              <p style="margin: 2px 0 2px; font-size: 0.88rem;"><strong>Contact :</strong> <%= c.phone %></p>
              <p style="margin: 4px 0 0; font-size: 0.85rem; color: var(--muted); background: var(--surface-subtle); padding: 8px; border-radius: 6px;">
                <strong>Justificatif / Précisions :</strong> <%= c.proof_details || 'Aucune précision' %>
              </p>
            </div>
            <div style="display: flex; gap: 8px;">
              <button type="button" class="btn btn-primary" onclick="moderateClaim(<%= c.id %>, 'approve')" style="font-size: 0.82rem; padding: 8px 14px;">
                ✓ Approuver
              </button>
              <button type="button" class="btn danger" onclick="moderateClaim(<%= c.id %>, 'reject')" style="font-size: 0.82rem; padding: 8px 14px;">
                ✕ Rejeter
              </button>
            </div>
          </div>
          <small class="muted" style="display: block; margin-top: 8px;">Demandé le <%= new Date(c.created_at).toLocaleString('fr-FR') %></small>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<!-- ================= SECTION 3 : MODÉRATION DES ABUS ================= -->
<div id="tab-abuse" class="admin-section hidden">
  <h2 style="font-size: 1.25rem; margin-bottom: 12px;">Signalements d'Abus en Attente</h2>
  <p class="muted" style="font-size: 0.88rem; margin-bottom: 16px;">
    Examinez les signalements signalés par la communauté pour fausse information, spam ou contenu abusif.
  </p>

  <% const pendingAbuse = abuseList.filter(a => a.status === 'pending'); %>
  <% if (pendingAbuse.length === 0) { %>
    <div class="card" style="text-align: center; padding: 24px; color: var(--muted);">
      Aucun abus en attente. Tout est propre.
    </div>
  <% } else { %>
    <div style="display: grid; gap: 12px;">
      <% for (const a of pendingAbuse) { %>
        <% const rep = allReports.find(r => r.id === a.report_id); %>
        <% const st = rep ? stations.find(s => s.id === rep.station_id) : null; %>
        <div class="card" style="border-left: 4px solid var(--crimson);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap;">
            <div>
              <span class="chip" style="background: var(--crimson-soft); color: var(--crimson); font-size: 0.78rem; font-weight: 700;">Motif : <%= a.reason %></span>
              <p style="margin: 8px 0 4px; font-size: 0.9rem;"><strong>Détails du plaignant :</strong> <%= a.details || 'Aucun détail' %></p>
              
              <div style="background: var(--surface-subtle); padding: 10px; border-radius: 6px; margin-top: 8px; border: 1px solid var(--line);">
                <strong style="font-size: 0.85rem; color: var(--pine-dark);">Signalement ciblé (Station : <%= st ? st.name : 'Inconnue' %>) :</strong>
                <p style="margin: 4px 0; font-size: 0.85rem;"><%= rep ? (rep.comment || 'Sans commentaire') : 'Signalement supprimé' %></p>
                <small class="muted">Statut rapporté : <%= rep ? rep.fuel_status : '' %> · File : <%= rep ? rep.queue_status : '' %></small>
              </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 6px;">
              <button type="button" class="btn danger" onclick="moderateAbuse(<%= a.id %>, 'hide_report')" style="font-size: 0.8rem; padding: 6px 12px;">
                Masquer le signalement
              </button>
              <button type="button" class="btn danger" onclick="moderateAbuse(<%= a.id %>, 'suspend_user')" style="font-size: 0.8rem; padding: 6px 12px;">
                Suspendre l'auteur
              </button>
              <button type="button" class="btn" onclick="moderateAbuse(<%= a.id %>, 'dismiss')" style="font-size: 0.8rem; padding: 6px 12px; background: var(--surface); border: 1px solid var(--line);">
                Classer sans suite
              </button>
            </div>
          </div>
          <small class="muted" style="display: block; margin-top: 8px;">Reçu le <%= new Date(a.created_at).toLocaleString('fr-FR') %></small>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<!-- ================= SECTION 4 : UTILISATEURS ================= -->
<div id="tab-users" class="admin-section hidden">
  <h2 style="font-size: 1.25rem; margin-bottom: 12px;">Utilisateurs</h2>
  <div style="overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md);">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
      <thead>
        <tr style="background: var(--surface-subtle); border-bottom: 1px solid var(--line); color: var(--muted);">
          <th style="padding: 12px 14px;">Utilisateur</th>
          <th style="padding: 12px 14px;">Rôle</th>
          <th style="padding: 12px 14px;">Statut</th>
          <th style="padding: 12px 14px;">Inscrit le</th>
          <th style="padding: 12px 14px; text-align: right;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% for (const u of userList) { %>
          <tr style="border-bottom: 1px solid var(--line);">
            <td style="padding: 12px 14px;">
              <strong><%= u.name %></strong>
              <% if (u.email) { %><div class="muted" style="font-size: 0.78rem;"><%= u.email %></div><% } %>
            </td>
            <td style="padding: 12px 14px;">
              <% if (u.is_admin) { %>
                <span class="chip" style="background: var(--amber-soft); color: var(--amber-dark); font-size: 0.75rem; font-weight: 700;">Admin</span>
              <% } else { %>
                <span class="muted" style="font-size: 0.8rem;">Utilisateur</span>
              <% } %>
            </td>
            <td style="padding: 12px 14px;">
              <% if (u.is_suspended) { %>
                <span class="chip" style="background: var(--crimson-soft); color: var(--crimson); font-size: 0.75rem;">Suspendu</span>
              <% } else { %>
                <span class="chip" style="background: var(--emerald-100); color: var(--emerald-600); font-size: 0.75rem;">Actif</span>
              <% } %>
            </td>
            <td style="padding: 12px 14px; font-size: 0.8rem; color: var(--muted);">
              <%= new Date(u.created_at).toLocaleDateString('fr-FR') %>
            </td>
            <td style="padding: 12px 14px; text-align: right;">
              <% if (!u.is_admin || u.id !== user.id) { %>
                <button type="button" class="btn" style="padding: 6px 10px; font-size: 0.78rem; background: var(--surface); border: 1px solid var(--line);" onclick="toggleSuspendUser(<%= u.id %>)">
                  <%= u.is_suspended ? 'Rétablir' : 'Suspendre' %>
                </button>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- ================= SECTION 5 : JOURNAL D'AUDIT ================= -->
<div id="tab-logs" class="admin-section hidden">
  <h2 style="font-size: 1.25rem; margin-bottom: 12px;">Journal des Actions Administratives</h2>
  <% if (logs.length === 0) { %>
    <div class="card" style="text-align: center; padding: 24px; color: var(--muted);">
      Aucune action enregistrée pour le moment.
    </div>
  <% } else { %>
    <div style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden;">
      <% for (const l of logs.slice().reverse()) { %>
        <div style="padding: 12px 16px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px;">
          <div>
            <strong style="color: var(--pine-dark); font-size: 0.9rem;"><%= l.action %></strong>
            <span class="muted" style="font-size: 0.82rem; margin-left: 8px;">par <%= l.admin_name %></span>
            <div style="font-size: 0.85rem; color: var(--ink-secondary); margin-top: 2px;"><%= l.details %></div>
          </div>
          <small class="muted" style="font-size: 0.75rem;"><%= new Date(l.created_at).toLocaleString('fr-FR') %></small>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<!-- ================= MODAL AJOUT STATION ================= -->
<div id="add-station-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="add-station-title">
  <div class="modal-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
      <h2 id="add-station-title" style="margin: 0; font-size: 1.2rem; color: var(--pine-dark);">Ajouter une station officielle</h2>
      <button type="button" onclick="toggleAddStationModal(false)" aria-label="Fermer" style="background: transparent; border: none; font-size: 1.2rem; color: var(--muted); cursor: pointer; min-height: auto; padding: 4px 8px;">✕</button>
    </div>

    <div id="add-station-error" class="hidden" style="background: var(--crimson-soft); color: var(--crimson); padding: 10px 12px; border-radius: var(--radius-xs); font-size: 0.85rem; font-weight: 600; margin-bottom: 12px;"></div>

    <form id="add-station-form" action="/api/admin/stations" method="POST" onsubmit="submitNewStation(event)">
      <label>Nom de la station *
        <input type="text" id="admin_station_name" name="name" required placeholder="ex: Kobil Rohero">
      </label>
      <label>Marque
        <input type="text" id="admin_station_brand" name="brand" placeholder="ex: Kobil, InterPetrol, Delta">
      </label>
      <label>Commune *
        <select id="admin_station_commune" name="commune" required>
          <option value="Mukaza">Mukaza</option>
          <option value="Muha">Muha</option>
          <option value="Ntahangwa">Ntahangwa</option>
        </select>
      </label>
      <label>Quartier / Zone *
        <input type="text" id="admin_station_zone" name="zone" required placeholder="ex: Rohero, Kinindo, Kigobe">
      </label>
      <label>Localisation textuelle *
        <input type="text" id="admin_station_location" name="location_text" required placeholder="ex: Boulevard de la JRR">
      </label>
      <label>Point de repère
        <input type="text" id="admin_station_landmark" name="landmark" placeholder="ex: En face de la Regideso">
      </label>
      <label>Types de carburants
        <input type="text" id="admin_station_fuels" name="fuels" value="Essence,Diesel" placeholder="ex: Essence,Diesel">
      </label>
      <div style="display: flex; gap: 10px; margin-top: 16px; justify-content: flex-end;">
        <button type="button" class="btn" onclick="toggleAddStationModal(false)" style="background: var(--surface); border: 1px solid var(--line);">Annuler</button>
        <button type="submit" id="submit-station-btn" class="btn btn-primary">Enregistrer la station</button>
      </div>
    </form>
  </div>
</div>

<script>
  function showAdminBanner(msg, isError = false) {
    const banner = document.getElementById('admin-feedback-banner');
    if (!banner) return;
    banner.textContent = msg;
    banner.style.borderLeftColor = isError ? 'var(--crimson)' : 'var(--emerald-600)';
    banner.style.color = isError ? 'var(--crimson)' : 'var(--pine-dark)';
    banner.classList.remove('hidden');
  }

  function showAdminTab(tabName, btnEl) {
    document.querySelectorAll('.admin-section').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.admin-tab-btn').forEach(btn => btn.classList.remove('selected'));

    const section = document.getElementById('tab-' + tabName);
    if (section) section.classList.remove('hidden');

    if (btnEl) btnEl.classList.add('selected');
  }

  function toggleAddStationModal(show) {
    const modal = document.getElementById('add-station-modal');
    const errEl = document.getElementById('add-station-error');
    if (errEl) errEl.classList.add('hidden');
    if (!modal) return;
    modal.classList.toggle('hidden', !show);
    if (show) {
      setTimeout(() => {
        document.getElementById('admin_station_name')?.focus();
      }, 50);
    }
  }

  function filterAdminStations(q) {
    const val = (q || '').toLowerCase().trim();
    document.querySelectorAll('.admin-station-row').forEach(row => {
      const name = row.dataset.name || '';
      const zone = row.dataset.zone || '';
      const commune = row.dataset.commune || '';
      const matches = name.includes(val) || zone.includes(val) || commune.includes(val);
      row.style.display = matches ? '' : 'none';
    });
  }

  async function toggleStationActive(id) {
    const r = await fetch('/api/admin/stations/' + id + '/toggle', {
      method: 'POST',
      credentials: 'same-origin'
    });
    if (r.ok) {
      location.reload();
    } else {
      showAdminBanner('Erreur lors du changement de statut de la station.', true);
    }
  }

  async function submitNewStation(e) {
    e.preventDefault();
    const errEl = document.getElementById('add-station-error');
    const submitBtn = document.getElementById('submit-station-btn');
    if (errEl) errEl.classList.add('hidden');

    const payload = {
      name: document.getElementById('admin_station_name').value.trim(),
      brand: document.getElementById('admin_station_brand').value.trim() || null,
      commune: document.getElementById('admin_station_commune').value,
      zone: document.getElementById('admin_station_zone').value.trim(),
      location_text: document.getElementById('admin_station_location').value.trim(),
      landmark: document.getElementById('admin_station_landmark').value.trim() || null,
      fuels: document.getElementById('admin_station_fuels').value.trim() || 'Essence,Diesel'
    };

    if (!payload.name || !payload.zone || !payload.location_text) {
      if (errEl) {
        errEl.textContent = 'Veuillez remplir le nom, le quartier/zone et la localisation de la station.';
        errEl.classList.remove('hidden');
      }
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enregistrement…';
    }

    try {
      const r = await fetch('/api/admin/stations', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
      });
      const d = await r.json().catch(() => ({}));
      if (r.ok) {
        toggleAddStationModal(false);
        location.reload();
      } else {
        if (errEl) {
          errEl.textContent = d.detail || 'Erreur lors de la création de la station.';
          errEl.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Enregistrer la station';
        }
      }
    } catch (err) {
      if (errEl) {
        errEl.textContent = 'Erreur réseau lors de la création de la station.';
        errEl.classList.remove('hidden');
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enregistrer la station';
      }
    }
  }

  async function moderateClaim(id, action) {
    const r = await fetch('/api/admin/claims/' + id + '/moderate', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, reason: '' })
    });
    if (r.ok) location.reload();
    else showAdminBanner('Erreur lors du traitement de la demande.', true);
  }

  async function moderateAbuse(id, action) {
    const r = await fetch('/api/admin/abuse/' + id + '/moderate', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action })
    });
    if (r.ok) location.reload();
    else showAdminBanner('Erreur lors de la modération.', true);
  }

  async function toggleSuspendUser(id) {
    const r = await fetch('/api/admin/users/' + id + '/toggle-suspend', {
      method: 'POST',
      credentials: 'same-origin'
    });
    if (r.ok) location.reload();
    else showAdminBanner('Erreur lors de la mise à jour de l’utilisateur.', true);
  }
</script>

