<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <%
    const pageTitle = typeof title !== 'undefined' && title ? title : 'Igitoro Live — Stations-service & Carburant à Bujumbura';
    const pageDesc = typeof ogDescription !== 'undefined' && ogDescription
      ? ogDescription
      : 'Tu cherches. Tu observes. Tu aides. Consultez et partagez en temps réel les observations communautaires sur les stations-service à Bujumbura.';
    const shareOrigin = typeof publicOrigin !== 'undefined' && publicOrigin ? publicOrigin : 'https://igitorolive.up.railway.app';
    const pageCanonical = typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : (shareOrigin + '/');
    const pageOgTitle = typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : pageTitle;
    const pageOgImage = `${shareOrigin}/static/icons/og-share.png?v=2`;
  %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <link rel="canonical" href="<%= pageCanonical %>">

  <!-- Open Graph / WhatsApp / Facebook / LinkedIn -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Igitoro Live">
  <meta property="og:locale" content="fr_BI">
  <meta property="og:title" content="<%= pageOgTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:url" content="<%= pageCanonical %>">
  <meta property="og:image" content="<%= pageOgImage %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Igitoro Live — Tu cherches. Tu observes. Tu aides. Entraide carburant à Bujumbura">

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageOgTitle %>">
  <meta name="twitter:description" content="<%= pageDesc %>">
  <meta name="twitter:image" content="<%= pageOgImage %>">

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Igitoro Live",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All",
    "url": "<%= shareOrigin %>/",
    "description": "Plateforme citoyenne d'entraide pour consulter, signaler et confirmer les observations sur les stations-service à Bujumbura."
  }
  </script>

  <link rel="manifest" href="/static/manifest.json?v=3">
  <link rel="icon" type="image/svg+xml" href="/static/icons/icon.svg?v=2">
  <link rel="icon" type="image/png" sizes="32x32" href="/static/icons/favicon-32.png?v=2">
  <link rel="apple-touch-icon" sizes="180x180" href="/static/icons/icon-180.png?v=2">
  <meta name="theme-color" content="#1A3C2A">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Igitoro">

  <!-- Préchargement du CSS principal et chargement asynchrone non-bloquant des polices -->
  <link rel="preload" href="/static/css/app.css?v=3" as="style">
  <link rel="stylesheet" href="/static/css/app.css?v=3">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" media="print" onload="this.media='all'">
</head>
<body>
  <header class="app-header">
    <div class="header-inner">
      <div class="brand-wrapper">
        <a class="brand" href="/" aria-label="Accueil Igitoro Live">
          <span class="brand-icon">⛽</span>
          <span>Igitoro <b>Live</b></span>
        </a>
        <span class="live-indicator" title="Service actif en direct à Bujumbura">
          <span class="pulse-dot"></span>
          <span class="live-text">Bujumbura</span>
        </span>
      </div>

      <nav class="desktop-nav" aria-label="Navigation principale">
        <a href="/" class="nav-link">Stations</a>
        <a href="/partager" class="nav-link">🤝 Partager</a>
        <a href="/signaler" class="nav-btn-cta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Signaler</span>
        </a>
        <a href="/notifications" class="nav-link">Alertes</a>
        <a href="/profil" class="nav-link">Profil</a>
        <% if (typeof user !== 'undefined' && user && user.is_admin) { %>
          <a href="/admin" class="nav-link" style="color: #FBD368; font-weight: 700;">Admin</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="app-main">
