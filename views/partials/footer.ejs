  <script>
    (function() {
      const path = window.location.pathname;
      if (path === '/' || path.startsWith('/stations')) {
        document.getElementById('tab-stations')?.classList.add('active');
      } else if (path === '/signaler') {
        document.getElementById('tab-signaler')?.classList.add('active');
      } else if (path === '/partager' || path === '/share') {
        document.getElementById('tab-partager')?.classList.add('active');
      } else if (path === '/notifications') {
        document.getElementById('tab-alertes')?.classList.add('active');
      } else if (path === '/profil') {
        document.getElementById('tab-profil')?.classList.add('active');
      }

      // Préchargement instantané au toucher (touchstart / mouseenter) pour des transitions immédiates sur mobile
      const prefetched = new Set();
      function prefetchUrl(href) {
        if (!href || !href.startsWith('/') || href.startsWith('//') || prefetched.has(href)) return;
        prefetched.add(href);
        const link = document.createElement('link');
        link.rel = 'prefetch';
        link.href = href;
        document.head.appendChild(link);
      }

      document.addEventListener('touchstart', (e) => {
        const a = e.target.closest && e.target.closest('a[href]');
        if (a) prefetchUrl(a.getAttribute('href'));
      }, { passive: true });

      document.addEventListener('mouseenter', (e) => {
        const a = e.target.closest && e.target.closest('a[href]');
        if (a) prefetchUrl(a.getAttribute('href'));
      }, { passive: true, capture: true });

      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    })();
  </script>
