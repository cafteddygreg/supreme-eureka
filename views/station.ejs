<%- include('partials/header', { title: station ? station.name : 'Station' }) %>
<% if (station) { %>
  <a href="/">← Retour</a>
  <section>
    <span class="chip"><%= station.zone %></span>
    <h1><%= station.name %></h1>
    <p><%= station.location_text %><%= station.landmark ? ' · ' + station.landmark : '' %></p>
    <a class="button" target="_blank" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(station.location_text + ' ' + station.name) %>">Voir l’itinéraire</a>
  </section>
  <section class="card">
    <h2>Situation récente</h2>
    <b><%= statusLabels[state.status] || 'Pas d’information récente' %></b>
    <p>File : <%= state.queue %> · <%= state.freshness %></p>
    <p>Confirmations : <%= state.confirmations %> · Contradictions : <%= state.contradictions %></p>
  </section>
  <% for (const r of reports) { %>
    <article class="card">
      <b><%= r.fuel_status %></b> · file <%= r.queue_status %>
      <p><%= r.comment || '' %></p>
      <% if (r.photo_path) { %>
        <p><img src="<%= r.photo_path %>" alt="Photo" style="max-width: 100%; border-radius: 8px; margin-top: 8px;"></p>
      <% } %>
      <div class="actions">
        <button onclick="verifyReport(<%= r.id %>, 'confirm')">Confirmer</button>
        <button onclick="verifyReport(<%= r.id %>, 'no_longer_true')">Ce n’est plus vrai</button>
        <button onclick="openAbuseModal(<%= r.id %>)">Signaler un abus</button>
      </div>
    </article>
  <% } %>
  <div id="abuse-modal" class="modal hidden">
    <div class="modal-card">
      <h2>Signaler un abus</h2>
      <input type="radio" name="abuse_reason" value="Faux signalement" checked> Faux signalement<br>
      <input type="radio" name="abuse_reason" value="Spam"> Spam<br>
      <input type="radio" name="abuse_reason" value="Insulte/comportement abusif"> Insulte / comportement abusif<br>
      <input type="radio" name="abuse_reason" value="Autre"> Autre
      <textarea id="abuse-details" placeholder="Détails facultatifs"></textarea>
      <button onclick="closeAbuseModal()">Annuler</button>
      <button class="danger" onclick="submitAbuse()">Signaler</button>
    </div>
  </div>
<% } else { %>
  <div class="card">Station introuvable.</div>
<% } %>
<%- include('partials/footer') %>
